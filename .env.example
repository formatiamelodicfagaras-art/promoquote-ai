# ── PromoQuote AI — environment example ─────────────────────────────
# Copy this file to `.env` and fill in real values for production.
# Defaults shown are safe for local demo with docker-compose.

# ── Backend ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./promoquote.db
JWT_SECRET=change-me-please-set-JWT_SECRET-env-var

# Optional: AI chat assistant. Leave empty to disable the AI chat feature.
ANTHROPIC_API_KEY=

# ── Meilisearch (product search engine) ─────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=
MEILISEARCH_ENABLED=true

# ── Image cache ─────────────────────────────────────────────────────
IMG_CACHE_DIR=./data/img_cache

# ── Frontend ────────────────────────────────────────────────────────
# When using docker-compose, the frontend talks to the backend through
# the host alias `backend`. For standalone `npm run dev`, set this to
# http://localhost:8000/api.
NEXT_PUBLIC_API_URL=/api

# ── Default company shown in generated PDFs ─────────────────────────
COMPANY_NAME=Demo Company SRL
COMPANY_EMAIL=demo@example.com
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_CUI=
